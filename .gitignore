# =============================================================================
# SatAi — .gitignore
# Principle: only source, documents and empty markers enter git. Everything the
# pipeline downloads, generates or trains is reproducible and can weigh GBs.
# =============================================================================

# ---------- Virtual environments ----------
.venv/
venv/
env/
.ENV/

# ---------- Python caches ----------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Pipeline data (FITS, crops, validation images) ----------
Data/**
!Data/
!Data/fits_raw/
!Data/fits_raw/.gitkeep
!Data/png_samples/
!Data/png_samples/.gitkeep
!Data/ui_uploads/
!Data/ui_uploads/.gitkeep
!Data/ui_uploads/.gitkeep

# ---------- Trained models and checkpoints ----------
#Models/**
#!Models/
#!Models/.gitkeep
#!Models/README.md
#*.pt
#*.pth
#*.ckpt
#*.safetensors
#*.mlmodel
#*.mlpackage
#*.mlpackage/**

# ---------- Local review folder (nothing is deleted automatically, DEPRECATED) ----------
Trash/

# ---------- Images and photos (never commit) ----------
*.png
*.jpg
*.jpeg
*.jpe
*.jfif
*.tif
*.tiff
*.gif
*.bmp
*.webp
*.heic
*.heif
*.avif
*.ico
*.svg
*.psd
*.raw
*.cr2
*.nef
*.arw

# ---------- Astronomy / scientific arrays ----------
*.fits
*.fit
*.fts
*.fz
*.fits.gz
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.parquet
*.vot
*.xml

# ---------- Generated output ----------
*.csv
*.tsv
*.log
predictions*.csv
evaluation_report.txt
confusion_matrix.png
reports/

# ---------- Astronomy caches ----------
.astropy/
astroquery/
.ipynb_checkpoints/

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- Local tools workspace ----------
.freebuff/

# ---------- Desktop app local settings (OpenRouter key — secret) ----------
# Kept in Config/ since the root was getting crowded; the bare pattern also
# covers a legacy settings.local.json at the project root.
Config/settings.local.json
settings.local.json

# ---------- Generated app bundle and icons (rebuild: Tools/make_app.py) ----------
SatAi.app/
assets/
# ...except the brand logo source of truth, which must be versioned:
!assets/
!assets/branding/
!assets/branding/SatAI_logo.png
# ...and the small header copy used by the UI:
!App/ui/logo.png

# ---------- 3D visualization ----------
# The 216 frame PNG sequence is a large, regenerable render cache.
Visuals/renders/
Visuals/*.blend1
# These two stills are documentation assets, not throwaway renders.
!Visuals/satai_network_3d_wide.png
!Visuals/satai_network_3d_head.png
